# ==================================================================
#  MẪU CẤU HÌNH - COPY FILE NÀY THÀNH .env RỒI ĐIỀN THÔNG TIN THẬT
# ------------------------------------------------------------------
#  cp .env.example .env
#
#  Thứ tự các giá trị RẤT QUAN TRỌNG (bản gốc bị đảo DB_DATABASE và
#  DB_USERNAME khiến site không kết nối được database):
#     DB_DATABASE = TÊN DATABASE
#     DB_USERNAME = TÊN USER của database
# ==================================================================

# Máy chủ database (hosting thường là localhost)
DB_HOST=localhost

# Tên database bạn tạo trong cPanel (vd: cpanel_sellgame)
DB_DATABASE=ten_database_cua_ban

# Tên user database (vd: cpanel_dbuser)
DB_USERNAME=ten_user_database

# Mật khẩu database
DB_PASSWORD=mat_khau_database

# URL gốc website (TUỲ CHỌN).
# Để trống -> hệ thống tự nhận diện từ HTTP_HOST.
# Nếu chạy sau Cloudflare/proxy mà link bị sai http/https, hãy điền rõ:
#   APP_URL=https://tenmiencuaban.com
APP_URL=
