# ==================================================================
#  .htaccess - ĐÃ SỬA LỖI 403 FORBIDDEN / 500 INTERNAL SERVER ERROR
# ------------------------------------------------------------------
#  CÁC NGUYÊN NHÂN GÂY LỖI TRONG BẢN GỐC (đã khắc phục hết):
#
#  (1) THIẾU "DirectoryIndex". Nhiều hosting (đặc biệt LiteSpeed/cPanel
#      cấu hình chặt) không tự chọn index.php -> Apache coi như yêu cầu
#      liệt kê thư mục, mà "Options -Indexes" lại chặn -> 403 FORBIDDEN.
#      Đây là nguyên nhân 403 phổ biến nhất khi vào trang chủ.
#
#  (2) Dùng cú pháp Apache 2.2 ("Order Deny,Allow" / "Deny from all").
#      Trên Apache 2.4 KHÔNG bật mod_access_compat, các directive này
#      là LỖI CÚ PHÁP -> toàn site trả 500, hoặc bị hiểu sai -> 403.
#      Nay dùng cả 2 cú pháp, tự chọn theo module có sẵn.
#
#  (3) Block <Files "waf"> có "satisfy all" - directive này đã bị loại
#      bỏ ở Apache 2.4, gây "Invalid command 'satisfy'" -> lỗi 500.
#      Ngoài ra không có file nào tên "waf" trong source -> đã xoá.
#
#  (4) 5 dòng "Header set ..." KHÔNG bọc trong <IfModule mod_headers.c>.
#      Nếu hosting tắt mod_headers -> "Invalid command 'Header'" -> 500.
#
#  (5) Chuyển hướng HTTPS chỉ kiểm tra %{HTTPS}. Khi site chạy sau
#      Cloudflare/proxy (SSL Flexible), %{HTTPS} luôn = off -> VÒNG LẶP
#      CHUYỂN HƯỚNG VÔ TẬN (ERR_TOO_MANY_REDIRECTS). Nay kiểm tra thêm
#      X-Forwarded-Proto và bỏ qua localhost.
#
#  (6) Các RewriteRule THIẾU neo cuối "$" và cờ [QSA]:
#      "^admin" khớp cả "/administrator", "/admin-abc"...
#      "^client" khớp cả "/clients-list". Đồng thời mất query string.
#      Nghiêm trọng hơn: KHÔNG có RewriteCond loại trừ file/thư mục
#      thật -> ảnh/CSS/JS trong /public cũng bị rewrite -> 404/403.
#
#  (7) Dòng "AddHandler application/x-httpd-ea-php74___lsphp" do cPanel
#      của HOSTING CŨ sinh ra. Khi chuyển sang hosting mới không có
#      package "ea-php74" -> Apache không biết xử lý .php -> TRẢ VỀ 403
#      FORBIDDEN hoặc tải file .php xuống thay vì chạy.
#      => ĐÃ XOÁ. Hãy chọn phiên bản PHP trong cPanel > Select PHP Version.
# ==================================================================

# ------------------------------------------------------------------
# (1) File mặc định của thư mục -> sửa lỗi 403 khi vào trang chủ
# ------------------------------------------------------------------
DirectoryIndex index.php index.html

# Không liệt kê nội dung thư mục, tắt MultiViews
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>
Options -Indexes

# ------------------------------------------------------------------
# (2) CHẶN FILE NHẠY CẢM - dùng cả cú pháp Apache 2.4 và 2.2
# ------------------------------------------------------------------
# Backup, database dump, log, script shell, file cấu hình...
<FilesMatch "\.(sql|zip|tar|gz|bak|log|ini|sh|lock|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# File cấu hình / hệ thống
<FilesMatch "^(\.env.*|\.htaccess|\.htpasswd|\.gitignore|\.gitattributes|error_log|composer\.(json|lock)|router\.php|ecosystem\.config\.cjs|package(-lock)?\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------
# (4) HEADER BẢO MẬT - bọc IfModule để không gây lỗi 500
# ------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "origin"
    Header unset X-Powered-By
    Header always unset X-Powered-By
    # Chỉ gửi HSTS khi đã thực sự chạy HTTPS
    <If "%{HTTPS} == 'on'">
        Header always set Strict-Transport-Security "max-age=157680000"
    </If>
</IfModule>

# ------------------------------------------------------------------
# NÉN GZIP
# ------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# ==================================================================
#  ĐIỀU HƯỚNG (ROUTING)
# ==================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Cho phép Let's Encrypt xác thực tên miền
    RewriteRule ^\.well-known/ - [L]

    # Chặn truy cập trực tiếp vào mã nguồn lõi
    RewriteRule ^(core|vendor|cron)/ - [F,L]

    # --------------------------------------------------------------
    # (5) CHUYỂN HƯỚNG HTTPS - chống vòng lặp khi chạy sau proxy
    # --------------------------------------------------------------
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # --------------------------------------------------------------
    # (6) KHÔNG rewrite khi là FILE hoặc THƯ MỤC thật
    #     (giúp ảnh / css / js trong /public tải bình thường)
    # --------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ==============================================================
    # ROUTE ADMIN
    # ==============================================================
    RewriteRule ^admin/bank-edit/([A-Za-z0-9-]+)/?$          index.php?module=admin&action=bank-edit&id=$1 [QSA,L]
    RewriteRule ^admin/user-edit/([A-Za-z0-9-]+)/?$          index.php?module=admin&action=user-edit&id=$1 [QSA,L]
    RewriteRule ^admin/edit-nick-robux/([A-Za-z0-9-]+)/?$    index.php?module=admin&action=edit-nick-robux&id=$1 [QSA,L]
    RewriteRule ^admin/edit-order-robux/([A-Za-z0-9-]+)/?$   index.php?module=admin&action=edit-order-robux&id=$1 [QSA,L]
    RewriteRule ^admin/edit-order-history/([A-Za-z0-9-]+)/?$ index.php?module=admin&action=edit-order-history&id=$1 [QSA,L]
    RewriteRule ^admin/([A-Za-z0-9-]+)/?$                    index.php?module=admin&action=$1 [QSA,L]
    RewriteRule ^admin/?$                                    index.php?module=admin&action=home [QSA,L]

    # ==============================================================
    # ROUTE CLIENT
    # ==============================================================
    # Trang thông báo / chính sách
    RewriteRule ^warranty-policy/?$ index.php?module=client&action=warranty-policy [QSA,L]
    RewriteRule ^use-bot/?$         index.php?module=client&action=use-bot [QSA,L]
    RewriteRule ^use-report/?$      index.php?module=client&action=use-report [QSA,L]
    RewriteRule ^2fa/?$             index.php?module=client&action=2fa [QSA,L]

    # Frontend
    RewriteRule ^DownloadFile/([A-Za-z0-9-]+)/?$ index.php?module=client&action=DownloadFile&magd=$1 [QSA,L]
    RewriteRule ^botcheck/notification/?$        index.php?module=client&action=checkbot&id=noti [QSA,L]
    RewriteRule ^botcheck/?$                     index.php?module=client&action=checkbot [QSA,L]
    RewriteRule ^orders/([A-Za-z0-9-]+)/?$       index.php?module=client&action=orders&magd=$1 [QSA,L]
    RewriteRule ^auth/nick-game/?$               index.php?module=client&action=nick-game [QSA,L]
    RewriteRule ^auth/history-nick/?$            index.php?module=client&action=history-nick [QSA,L]
    RewriteRule ^auth/deposit/?$                 index.php?module=client&action=deposit [QSA,L]
    RewriteRule ^auth/transaction/?$             index.php?module=client&action=transaction [QSA,L]
    RewriteRule ^auth/history-order/?$           index.php?module=client&action=history-order [QSA,L]
    RewriteRule ^auth/profile/?$                 index.php?module=client&action=profile [QSA,L]
    RewriteRule ^auth/logout/?$                  index.php?module=client&action=logout [QSA,L]
    RewriteRule ^auth/register/?$                index.php?module=client&action=register [QSA,L]
    RewriteRule ^auth/login/?$                   index.php?module=client&action=login [QSA,L]
    RewriteRule ^client/([A-Za-z0-9-]+)/?$       index.php?module=client&action=$1 [QSA,L]
    RewriteRule ^client/?$                       index.php?module=client&action=home [QSA,L]
</IfModule>

# ------------------------------------------------------------------
# TRANG LỖI
# ------------------------------------------------------------------
ErrorDocument 404 /404.php

# ==================================================================
#  (7) LƯU Ý QUAN TRỌNG VỀ PHIÊN BẢN PHP
# ------------------------------------------------------------------
#  KHÔNG thêm lại dòng AddHandler ...ea-php74___lsphp của cPanel cũ.
#  Nó trỏ tới package PHP của hosting CŨ, hosting mới không có ->
#  gây lỗi 403 Forbidden hoặc trình duyệt tải file .php về máy.
#
#  Hãy chọn phiên bản PHP (khuyến nghị PHP 7.4 - 8.2) tại:
#      cPanel > "Select PHP Version"  hoặc  "MultiPHP Manager"
# ==================================================================
